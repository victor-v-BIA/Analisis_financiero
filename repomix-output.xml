            _reiniciar_diagnostico()

        st.markdown("---")
        
        metodo_carga = st.toggle("Empresa con múltiples archivos (Usar Google Drive)", value=False)
        
        tipos_archivo = {
            "ingresos_facturas": [], "ingresos_pago": [], "egresos_facturas": [],
